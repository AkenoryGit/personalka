<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Вход на сервер (шаг 2.8а): аккаунт, дальше — синхронизация и кабинеты. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Уведомления (шаг 2.5, ТЗ 5.19): разрешение Android 13+ и будильник, который переживает перезагрузку телефона.
         Точный будильник не нужен: сводке в 21:03 вместо 21:00 это не мешает. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Голосовой ввод в дневнике (шаг 2.1): с Android 11 приложение видит службу распознавания речи
         и её окно, только если назовёт их здесь; так же — Макс (шаг 3.9ж). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- «Написать в Макс» в карточке клиента (шаг 3.9ж): кнопка видна, только если Макс установлен. -->
        <package android:name="ru.oneme.app" />
    </queries>

    <!-- Данные клиентов не уходят в облачную копию Google: копии — только свои, зашифрованные (ТЗ 7.6, 10.3).
         allowBackup — для Android 10–11, dataExtractionRules — для Android 12+. -->
    <application
        android:name="com.akenory.personalka.android.PersonalkaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Personalka"
        tools:targetApi="31">

        <!-- configChanges: сложение и разложение Fold, поворот и смена размера окна не пересоздают экран —
             Compose перекладывает его сам, открытый раздел и прокрутка не теряются (ТЗ 5.1).
             Смена темы (uiMode) пересоздаёт окно: так обновляются цвета системных панелей;
             состояние при этом сохранено через rememberSaveable. -->
        <activity
            android:name="com.akenory.personalka.android.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Отчёт 1С (шаг 4.2б, ТЗ 5.14): «Поделиться → Персоналка» из почты или мессенджера и «Открыть с помощью». -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Будильник напоминаний и события, после которых его надо поставить заново. -->
        <receiver
            android:name="com.akenory.personalka.android.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Обмен с сервером раз в 15 минут при закрытом приложении (шаг 2.10а). -->
        <service
            android:name="com.akenory.personalka.android.SyncJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- «Поделиться копией» и календарём .ics: файл из временной папки по ссылке с правом только на чтение. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
    </application>

</manifest>
