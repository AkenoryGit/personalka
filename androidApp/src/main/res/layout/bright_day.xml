<?xml version="1.0" encoding="utf-8"?>
<!-- Яркий виджет «День» (шаг 5.9б). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bright_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bright_day_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/bright_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="#D9F7E4"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/bright_big"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/bright_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="#D9F7E4"
        android:textSize="12sp" />
    <ImageView
        android:id="@+id/bright_image"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/bright_day_image"
        android:scaleType="fitXY" />

    <TextView
        android:id="@+id/bright_chip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="6dp" />
</LinearLayout>
