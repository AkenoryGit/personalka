<?xml version="1.0" encoding="utf-8"?>
<!-- Яркий виджет «Дорожка» (шаг 5.9б). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bright_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bright_lane_bg"
    android:gravity="top"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bright_label"
        android:text="СЕЙЧАС"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bright_right"
        android:text="до 12:50"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bright_big"
        android:text="Никитин А."
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/bright_sub"
        android:text="ПТ · ББ · ещё 9 сегодня"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="#E0F6F1"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/bright_image"
        android:src="@drawable/preview_lane"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:contentDescription="@string/bright_lane_image"
        android:scaleType="fitXY" />
</LinearLayout>
