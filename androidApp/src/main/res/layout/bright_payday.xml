<?xml version="1.0" encoding="utf-8"?>
<!-- Яркий виджет «До получки» (шаг 5.9б). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bright_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bright_payday_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/bright_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="#FBE3F0"
        android:textSize="13sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bright_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="52sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bright_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/bright_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium" />
    <ImageView
        android:id="@+id/bright_image"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/bright_payday_image"
        android:scaleType="fitXY" />
</LinearLayout>
