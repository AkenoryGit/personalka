<?xml version="1.0" encoding="utf-8"?>
<!-- Яркий виджет «Тюля» — талисман (шаг 5.9б). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bright_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bright_tyulya_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/bright_image"
        android:layout_width="116dp"
        android:layout_height="match_parent"
        android:layout_marginBottom="-18dp"
        android:contentDescription="@string/bright_tyulya_image"
        android:scaleType="fitEnd"
        android:src="@drawable/tyulya_wave" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bright_big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="#15171A"
            android:textSize="26sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/bright_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:maxLines="2"
            android:textColor="#15171A"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/bright_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bright_tyulya_pill"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:paddingStart="9dp"
            android:paddingTop="4dp"
            android:paddingEnd="9dp"
            android:paddingBottom="4dp"
            android:textColor="#15171A"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
