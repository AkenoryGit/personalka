            <TextView
                android:id="@+id/next7_sub"
                style="@style/WidgetCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/widget_text_muted" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/next8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/next8_time"
                style="@style/WidgetCaption"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_muted" />

            <ImageView
                android:id="@+id/next8_stripe"
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:background="@color/widget_outline" />

            <TextView
                android:id="@+id/next8_name"
                style="@style/WidgetRowName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/next8_sub"
                style="@style/WidgetCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/widget_text_muted" />
        </LinearLayout>

        <TextView
            android:id="@+id/more"
            style="@style/WidgetCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="56dp"
            android:textColor="@color/widget_text_muted"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/todo_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot_accent" />

            <TextView
                style="@style/WidgetRowName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_todo" />

            <TextView
                android:id="@+id/todo_count"
                style="@style/WidgetRowName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
