<?xml version="1.0" encoding="utf-8"?>
<!-- Большой виджет (шаг 5.9): «Деньги», «Сейчас» или «Следующая» и следующие тренировки дня — сколько влезает по высоте (5.9а). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <include layout="@layout/widget_money" />

    <TextView
        android:id="@+id/money_unset"
        style="@style/WidgetCaptionStrong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:importantForAccessibility="no"
        android:background="@color/widget_divider" />

    <LinearLayout
        android:id="@+id/now_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/now_header"
                style="@style/WidgetCaptionStrong"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/widget_text_muted" />

            <TextView
                android:id="@+id/now_right"
                style="@style/WidgetCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_muted" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/now_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/now_stripe"
                android:layout_width="3dp"
                android:layout_height="36dp"
                android:importantForAccessibility="no"
                android:background="@color/widget_outline" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/now_name"
                    style="@style/WidgetName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/now_sub"
                    style="@style/WidgetCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_muted" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/next1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/next1_time"
                style="@style/WidgetCaption"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_muted" />

            <ImageView
                android:id="@+id/next1_stripe"
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:background="@color/widget_outline" />

            <TextView
                android:id="@+id/next1_name"
                style="@style/WidgetRowName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/next1_sub"
                style="@style/WidgetCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/widget_text_muted" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/next2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/next2_time"
                style="@style/WidgetCaption"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_muted" />

            <ImageView
                android:id="@+id/next2_stripe"
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:background="@color/widget_outline" />

            <TextView
                android:id="@+id/next2_name"
                style="@style/WidgetRowName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/next2_sub"
                style="@style/WidgetCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/widget_text_muted" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/next3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/next3_time"
                style="@style/WidgetCaption"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_muted" />

            <ImageView
                android:id="@+id/next3_stripe"
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:background="@color/widget_outline" />

            <TextView
                android:id="@+id/next3_name"
                style="@style/WidgetRowName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/next3_sub"
                style="@style/WidgetCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/widget_text_muted" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/next4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/next4_time"
                style="@style/WidgetCaption"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_muted" />

            <ImageView
                android:id="@+id/next4_stripe"
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:background="@color/widget_outline" />

            <TextView
                android:id="@+id/next4_name"
                style="@style/WidgetRowName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/next4_sub"
                style="@style/WidgetCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/widget_text_muted" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/next5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/next5_time"
                style="@style/WidgetCaption"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_muted" />

            <ImageView
                android:id="@+id/next5_stripe"
                android:layout_width="3dp"
