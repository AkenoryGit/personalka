                android:background="@color/widget_outline" />

            <TextView
                android:id="@+id/next5_name"
                style="@style/WidgetRowName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/next5_sub"
                style="@style/WidgetCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/widget_text_muted" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/next6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/next6_time"
                style="@style/WidgetCaption"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_muted" />

            <ImageView
                android:id="@+id/next6_stripe"
                android:layout_width="3dp"
                android:layout_height="14dp"
