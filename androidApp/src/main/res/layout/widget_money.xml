<?xml version="1.0" encoding="utf-8"?>
<!-- «Деньги» в большом и среднем виджете (шаг 5.9): как карточка на «Главной», ТЗ 5.2. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/money"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/money_title"
            style="@style/WidgetCaptionStrong"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_text_muted" />

        <ImageView
            android:id="@+id/money_right_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_done"
            android:visibility="gone" />

        <TextView
            android:id="@+id/money_right"
            style="@style/WidgetCaptionStrong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/money_chip"
            style="@style/WidgetCaptionStrong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/WidgetCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_today"
                android:textColor="@color/widget_text_muted" />

            <TextView
                android:id="@+id/today_amount"
                style="@style/WidgetAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/today_will"
                style="@style/WidgetCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_muted" />

            <TextView
                android:id="@+id/today_pt"
                style="@style/WidgetCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/today_cancel"
                style="@style/WidgetCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_muted"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/WidgetCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_month"
                android:textColor="@color/widget_text_muted" />

            <TextView
                android:id="@+id/month_amount"
                style="@style/WidgetAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/month_will"
                style="@style/WidgetCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_muted" />

            <TextView
                android:id="@+id/month_pt"
                style="@style/WidgetCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/month_cancel"
                style="@style/WidgetCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_muted"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/widget_plan_bar" />

    <LinearLayout
        android:id="@+id/pace_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/pace_dot_ok"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_done" />

        <ImageView
            android:id="@+id/pace_dot_behind"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_charged"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pace_text"
            style="@style/WidgetCaptionStrong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
