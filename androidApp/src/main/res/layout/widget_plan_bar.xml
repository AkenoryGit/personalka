<?xml version="1.0" encoding="utf-8"?>
<!-- Полоса плана (шаг 5.9): снизу прогноз, сверху проведено; со ступени 2 проведено зелёным. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/plan_bar"
    android:layout_width="match_parent"
    android:layout_height="6dp"
    android:layout_marginTop="8dp">

    <ProgressBar
        android:id="@+id/bar_forecast"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="1000"
        android:progressDrawable="@drawable/widget_bar_forecast" />

    <ProgressBar
        android:id="@+id/bar_done"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="1000"
        android:progressDrawable="@drawable/widget_bar_done" />

    <ProgressBar
        android:id="@+id/bar_bonus"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="1000"
        android:progressDrawable="@drawable/widget_bar_bonus"
        android:visibility="gone" />
</FrameLayout>
