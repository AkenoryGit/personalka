# Настройки сервера (ТЗ 2.4): /etc/trener/trener.env, владелец root, группа trener, права 640.
# Образец без настоящих значений — сам файл в репозиторий не кладётся.
TRENER_DB_URL=jdbc:postgresql://127.0.0.1:5432/trener
TRENER_DB_USER=trener
TRENER_DB_PASSWORD=сменить
# Поддомен сервера и кабинетов — тот же, что в Caddyfile.
TRENER_DOMAIN=trener.planovo-app.ru
# Порт только для самого сервера: снаружи — Caddy. Не должен совпадать с портом Planovo.
TRENER_PORT=8090
# Куда писать о повторяющихся падениях (trener-alert.service).
TRENER_ALERT_EMAIL=
# Открытый ключ шифрования копий (ТЗ 7.6) — появится вместе с копиями на сервере.
TRENER_BACKUP_PUBLIC_KEY=
