# Служба сервера «Персоналки» (ТЗ 7.4): /etc/systemd/system/trener.service, кладёт deploy/setup.sh.
# Отдельно от Planovo: свой пользователь, своя база, свой порт; Java — не больше 384 МБ.
[Unit]
Description=Сервер «Персоналки»
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
# Пять падений за 10 минут — systemd перестаёт перезапускать, trener-alert.service пишет письмо.
StartLimitIntervalSec=600
StartLimitBurst=5
OnFailure=trener-alert.service

[Service]
User=trener
Group=trener
EnvironmentFile=/etc/trener/trener.env
# /opt/trener/java — ссылка на Java 21 (setup.sh).
ExecStart=/opt/trener/java -Xmx384m -XX:MaxMetaspaceSize=96m -XX:+UseSerialGC -Xss512k -jar /opt/trener/current/personalka-server.jar
# 143 — обычная остановка Java по SIGTERM.
SuccessExitStatus=143
Restart=always
RestartSec=5
# Урезанные права: служба только читает свои файлы и ходит в сеть.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=600M

[Install]
WantedBy=multi-user.target
